{
  "type": "MILESTONE",
  "name": "DICT:milestone.stones.gravity_well.name",
  "description": "DICT:milestone.stones.gravity_well.description",
  "required_level": 25.0,
  "icon": "stones:textures/gui/skills/gravitywell.png",
  "factor": 0.0,
  "max_level": 20,
  "stats": [
    {
      "id": "gravity_cooldown",
      "label": "DICT:stat.stones.pyro_recharge",
      "type": "generic",
      "base": 300.0,
      "per_level": -5.0,
      "scaling": "PLAYER_LEVEL",
      "display_factor": 0.05,
      "suffix": "DICT:stat.stones.suffix.seconds",
      "min": 120.0
    },
    {
      "id": "gravity_speed",
      "label": "DICT:stat.stones.pyro_speed",
      "type": "generic",
      "base": 0.12,
      "per_level": 0.01,
      "scaling": "RUNE_LEVEL",
      "suffix": "DICT:stat.stones.suffix.multiplier"
    },
    {
      "id": "gravity_radius",
      "label": "DICT:stat.stones.gravity_radius",
      "type": "generic",
      "base": 7.0,
      "per_level": 0.5,
      "scaling": "RUNE_LEVEL",
      "suffix": " m"
    },
    {
      "id": "gravity_damage",
      "label": "DICT:stat.stones.gravity_damage",
      "type": "generic",
      "base": 14.0,
      "per_level": 2.5,
      "scaling": "SOCK_LEVEL",
      "suffix": "DICT:stat.stones.suffix.damage"
    }
  ],
  "behaviors": [
    {
      "trigger": "ON_ACTION_BUTTON",
      "conditions": [
        {
          "type": "stones:is_ready",
          "name": "milestone_gravity_well"
        }
      ],
      "actions": [
        {
          "type": "stones:cooldown",
          "name": "milestone_gravity_well",
          "ticks": "$gravity_cooldown"
        },
        {
          "type": "stones:play_sound",
          "sound": "minecraft:block.respawn_anchor.charge",
          "volume": 1.2,
          "pitch": 0.4
        },
        {
          "type": "stones:spawn_projectile",
          "origin": "$player.eye_pos",
          "direction": "$player.look_angle",
          "speed": "$gravity_speed",
          "gravity": 0.0,
          "lifetime": 100,
          "hitbox_size": 0.6,
          "visuals": {
            "render_mode": "BILLBOARD",
            "texture": "data:image/png;base64,"
          },
          "on_tick": [
            {
              "type": "stones:spawn_sprite",
              "pos": "$pos",
              "texture": "data:image/png;base64,",
              "facing": "GROUND_FLAT",
              "blend_mode": "ADDITIVE",
              "lifetime": 15,
              "initial_scale": 1.0,
              "growth_rate": 0.15,
              "spin_speed": 7.0,
              "keyframes": [
                {
                  "time": 0.0,
                  "color": "#8000FF",
                  "alpha": 0.0
                },
                {
                  "time": 0.5,
                  "color": "#A020F0",
                  "alpha": 0.8
                },
                {
                  "time": 1.0,
                  "color": "#000000",
                  "alpha": 0.0
                }
              ],
              "speed": 0.5,
              "drag": 0.92,
              "gravity": 0.0
            },
            {
              "type": "stones:spawn_particles",
              "count": 15,
              "particle": "minecraft:reverse_portal",
              "spread": 0.6,
              "speed": -0.3,
              "pos": "$pos"
            },
            {
              "type": "stones:find_entities",
              "mode": "radius",
              "radius": "$gravity_radius",
              "living_only": true,
              "exclude_self": true,
              "line_of_sight": false,
              "pos": "$pos",
              "save_to": "pulled_mobs"
            },
            {
              "type": "stones:for_each",
              "from": "$pulled_mobs",
              "as": "curr_mob",
              "actions": [
                {
                  "type": "stones:add_velocity",
                  "target": "$curr_mob",
                  "vec": "$pos.subtract(ctx['curr_mob'].position()).normalize()",
                  "scale": 0.25
                },
                {
                  "type": "stones:apply_effect",
                  "target": "$curr_mob",
                  "effect": "minecraft:slowness",
                  "duration": 10,
                  "amplifier": 2
                }
              ]
            }
          ],
          "on_hit_entity": [
            {
              "type": "stones:play_sound",
              "sound": "minecraft:entity.warden.sonic_boom",
              "volume": 1.2,
              "pitch": 0.6
            },
            {
              "type": "stones:spawn_particles",
              "count": 80,
              "particle": "minecraft:sculk_charge_pop",
              "spread": 1.2,
              "speed": 0.6,
              "pos": "$hitPos"
            },
            {
              "type": "stones:explode",
              "radius": "$gravity_radius",
              "fire": false,
              "pos": "$hitPos"
            }
          ],
          "on_hit_block": [
            {
              "type": "stones:play_sound",
              "sound": "minecraft:entity.warden.sonic_boom",
              "volume": 1.2,
              "pitch": 0.6
            },
            {
              "type": "stones:spawn_particles",
              "count": 80,
              "particle": "minecraft:sculk_charge_pop",
              "spread": 1.2,
              "speed": 0.6,
              "pos": "$hitPos"
            },
            {
              "type": "stones:explode",
              "radius": "$gravity_radius",
              "fire": false,
              "pos": "$hitPos"
            }
          ],
          "render_mode": "BILLBOARD",
          "texture": "minecraft:textures/particle/glint.png"
        }
      ]
    }
  ],
  "_template_hash": "3478a4310bf2832d48f3ef02467033b1d2311e2844b89324f21e331a28e2cb53"
}