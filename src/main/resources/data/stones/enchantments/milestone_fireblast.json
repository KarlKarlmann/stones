{
  "type": "MILESTONE",
  "name": "DICT:milestone.stones.pyromancer.name",
  "description": "DICT:milestone.stones.pyromancer.description",
  "icon": "stones:textures/gui/skills/fireball.png",
  "required_level": 3,
  "stats": [
    {
      "id": "pyro_cooldown",
      "label": "DICT:stat.stones.pyro_recharge",
      "base": 40.0,
      "scaling": "RUNE_LEVEL",
      "per_level": -5.0,
      "display_factor": 0.05,
      "suffix": "DICT:stat.stones.suffix.seconds"
    },
    {
      "id": "pyro_speed",
      "label": "DICT:stat.stones.pyro_speed",
      "base": 1.0,
      "scaling": "PLAYER_LEVEL",
      "per_level": 0.05,
      "suffix": "DICT:stat.stones.suffix.multiplier"
    },
    {
      "id": "pyro_radius",
      "label": "DICT:stat.stones.pyro_radius",
      "base": 2.0,
      "scaling": "RUNE_LEVEL",
      "per_level": 0.5,
      "suffix": " m"
    }
  ],
  "behaviors": [
    {
      "trigger": "ON_ACTION_BUTTON",
      "conditions": [
        {
          "type": "stones:is_ready",
          "name": "pyro_shot"
        }
      ],
      "actions": [
        {
          "type": "stones:cooldown",
          "name": "pyro_shot",
          "ticks": "$pyro_cooldown"
        },
        {
          "type": "stones:add_combo",
          "id": "pyro_charge",
          "value": 1.0,
          "max": 3.0,
          "timeout": 60,
          "texture": "stones:textures/gui/combo_fire.png",
          "color": "#FF8800",
          "on_max": [
            {
              "type": "stones:apply_effect",
              "effect": "minecraft:fire_resistance",
              "duration": 60
            },
            {
              "type": "stones:play_sound",
              "sound": "minecraft:block.lava.extinguish",
              "pitch": 0.5
            },
            {
              "type": "stones:spawn_particles",
              "particle": "minecraft:lava",
              "count": 10,
              "speed": 0.1
            }
          ]
        },
        {
          "type": "stones:invoke",
          "call": "player.getLookAngle()",
          "save_result_to": "look"
        },
        {
          "type": "stones:invoke",
          "call": "player.getEyePosition(float)",
          "args": [
            "1.0"
          ],
          "save_result_to": "eye"
        },
        {
          "type": "stones:set_variable",
          "name": "px",
          "value": "$look.x"
        },
        {
          "type": "stones:math",
          "variable": "px",
          "operation": "multiply",
          "value": "$pyro_speed"
        },
        {
          "type": "stones:set_variable",
          "name": "py",
          "value": "$look.y"
        },
        {
          "type": "stones:math",
          "variable": "py",
          "operation": "multiply",
          "value": "$pyro_speed"
        },
        {
          "type": "stones:set_variable",
          "name": "pz",
          "value": "$look.z"
        },
        {
          "type": "stones:math",
          "variable": "pz",
          "operation": "multiply",
          "value": "$pyro_speed"
        },
        {
          "type": "stones:new",
          "class": "net.minecraft.world.entity.projectile.SmallFireball",
          "args": [
            "$level",
            "$player",
            "$px",
            "$py",
            "$pz"
          ],
          "save_to": "fb"
        },
        {
          "type": "stones:invoke",
          "call": "$fb.setPos(double, double, double)",
          "args": [
            "$eye.x",
            "$eye.y",
            "$eye.z"
          ]
        },
        {
          "type": "stones:invoke",
          "call": "level.addFreshEntity(net.minecraft.world.entity.Entity)",
          "args": [
            "$fb"
          ]
        },
        {
          "type": "stones:play_sound",
          "sound": "minecraft:entity.blaze.shoot",
          "volume": 1.0,
          "pitch": 0.8
        },
        {
          "type": "stones:spawn_particles",
          "particle": "minecraft:flame",
          "count": 15,
          "speed": 0.2
        }
      ]
    },
    {
      "trigger": "ON_PROJECTILE_HIT",
      "conditions": [
        {
          "type": "stones:variable_compare",
          "variable": "$projectile.getType().toString()",
          "operator": "==",
          "value": "entity.minecraft.small_fireball"
        }
      ],
      "actions": [
        {
          "type": "stones:explode",
          "radius": "$pyro_radius",
          "pos": "$hitPos",
          "fire": false
        },
        {
          "type": "stones:play_sound",
          "sound": "minecraft:entity.dragon_fireball.explode",
          "pos": "$hitPos",
          "volume": 0.8,
          "pitch": 1.2
        },
        {
          "type": "stones:spawn_particles",
          "particle": "minecraft:lava",
          "pos": "$hitPos",
          "count": 25,
          "speed": 0.5
        },
        {
          "type": "stones:spawn_particles",
          "particle": "minecraft:large_smoke",
          "pos": "$hitPos",
          "count": 20,
          "speed": 0.1
        }
      ]
    }
  ]
}
```