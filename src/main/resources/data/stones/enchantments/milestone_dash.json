{
  "type": "MILESTONE",
  "name": "DICT:milestone.stones.void_walker.name",
  "description": "DICT:milestone.stones.void_walker.description",
  "icon": "stones:textures/gui/skills/voiddash.png",
  "required_level": 2.0,
  "stats": [
    {
      "id": "dash_power",
      "label": "DICT:stat.stones.dash_power",
      "base": 2.0,
      "scaling": "PLAYER_LEVEL",
      "per_level": 0.1
    },
    {
      "id": "dash_cooldown",
      "label": "DICT:stat.stones.dash_cooldown",
      "base": 70.0,
      "scaling": "SOCK_LEVEL",
      "per_level": -0.6,
      "min": 20.0,
      "display_factor": 0.05,
      "suffix": "DICT:stat.stones.suffix.seconds"
    },
    {
      "id": "slow_fall_duration",
      "label": "DICT:stat.stones.slow_fall_duration",
      "base": 60.0,
      "scaling": "RUNE_LEVEL",
      "per_level": 20.0,
      "display_factor": 0.05,
      "suffix": "DICT:stat.stones.suffix.seconds"
    }
  ],
  "behaviors": [
    {
      "trigger": "ON_ACTION_BUTTON",
      "conditions": [
        {
          "type": "stones:is_ready",
          "name": "void_dash"
        }
      ],
      "actions": [
        {
          "type": "stones:cooldown",
          "name": "void_dash",
          "ticks": "$dash_cooldown"
        },
        {
          "type": "stones:invoke",
          "call": "player.getLookAngle()",
          "save_result_to": "look"
        },
        {
          "type": "stones:add_velocity",
          "vec": "$look",
          "scale": "$dash_power"
        },
        {
          "type": "stones:case",
          "cases": [
            {
              "conditions": {
                "type": "stones:variable_compare",
                "variable": "RuneLevel",
                "operator": ">=",
                "value": 5.0
              },
              "actions": [
                {
                  "type": "stones:apply_effect",
                  "effect": "minecraft:slow_falling",
                  "duration": "$slow_fall_duration",
                  "amplifier": 0
                }
              ]
            }
          ]
        },
        {
          "type": "stones:spawn_particles",
          "particle": "minecraft:portal",
          "count": 25,
          "speed": 0.1
        },
        {
          "type": "stones:play_sound",
          "sound": "minecraft:entity.enderman.teleport",
          "volume": 1.0,
          "pitch": 1.2
        }
      ]
    }
  ],
  "max_level": 20,
  "factor": 0.0,
  "_template_hash": "b2ee1c00c2f7684e471b4bb386e36c990e197478058628c2dfaea1bebe352f15"
