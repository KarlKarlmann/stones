{
  "override_registry_id": "stones:milestone_fireblast",
  "type": "MILESTONE",
  "name": "Fireblast",
  "description": "blasts Fire",
  "icon": "stones:textures/gui/skills/fireball.png",
  "required_level": 3.0,
  "factor": 0.0,
  "max_level": 20,
  "stats": [
    {
      "id": "pyro_cooldown",
      "label": "DICT:stat.stones.pyro_recharge",
      "type": "generic",
      "base": 40.0,
      "per_level": -5.0,
      "scaling": "RUNE_LEVEL",
      "display_factor": 0.05,
      "suffix": "DICT:stat.stones.suffix.seconds",
      "min": 10.0
    },
    {
      "id": "pyro_speed",
      "label": "DICT:stat.stones.pyro_speed",
      "type": "generic",
      "base": 1.0,
      "per_level": 0.05,
      "scaling": "PLAYER_LEVEL",
      "suffix": "DICT:stat.stones.suffix.multiplier"
    },
    {
      "id": "pyro_radius",
      "label": "DICT:stat.stones.pyro_radius",
      "type": "generic",
      "base": 2.0,
      "per_level": 0.5,
      "scaling": "RUNE_LEVEL",
      "suffix": " m"
    }
  ],
  "behaviors": [
    {
      "trigger": "ON_ACTION_BUTTON",
      "conditions": [
        {
          "type": "stones:is_ready",
          "name": "pyro_shot"
        }
      ],
      "actions": [
        {
          "type": "stones:cooldown",
          "name": "pyro_shot",
          "ticks": "$pyro_cooldown"
        },
        {
          "type": "stones:spawn_projectile",
          "origin": "$player.eye_pos",
          "direction": "$player.look_angle",
          "speed": "$pyro_speed",
          "gravity": 0.0,
          "lifetime": 80,
          "hitbox_size": 0.25,
          "visuals": {
            "render_mode": "BILLBOARD",
            "texture": "data:image/png;base64,"
          },
          "on_tick": [
            {
              "type": "stones:set_variable",
              "name": "temp",
              "value": "$age"
            },
            {
              "type": "stones:math",
              "variable": "temp",
              "operation": "modulo",
              "value": 1.5
            },
            {
              "type": "stones:spawn_particles",
              "count": 10,
              "particle": "minecraft:campfire_cosy_smoke",
              "spread": "$temp",
              "speed": 0.0,
              "pos": "$pos"
            },
            {
              "type": "stones:case",
              "cases": [
                {
                  "conditions": {
                    "type": "stones:chance",
                    "value": 0.2
                  },
                  "actions": [
                    {
                      "type": "stones:spawn_particles",
                      "count": 10,
                      "particle": "minecraft:campfire_signal_smoke",
                      "spread": "$temp",
                      "speed": 0.0,
                      "pos": "$pos"
                    }
                  ]
                }
              ]
            }
          ],
          "on_hit_entity": [
            {
              "type": "stones:explode",
              "radius": "$pyro_radius",
              "fire": false,
              "pos": "$hitPos"
            },
            {
              "type": "stones:find_blocks",
              "radius": "$pyro_radius",
              "tags": [
                "minecraft:mineable/shovel"
              ],
              "save_to": "destroyed_blocks",
              "pos": "$hitPos"
            },
            {
              "type": "stones:for_each",
              "from": "$destroyed_blocks",
              "as": "current",
              "actions": [
                {
                  "type": "stones:set_block",
                  "block": "minecraft:air",
                  "pos": "$current"
                }
              ]
            }
          ],
          "on_hit_block": [
            {
              "type": "stones:explode",
              "radius": "$pyro_radius",
              "fire": false,
              "pos": "$hitPos"
            },
            {
              "type": "stones:find_blocks",
              "radius": "$pyro_radius",
              "tags": [
                "minecraft:mineable/shovel"
              ],
              "save_to": "destroyed_blocks",
              "pos": "$hitPos"
            },
            {
              "type": "stones:for_each",
              "from": "$destroyed_blocks",
              "as": "current",
              "actions": [
                {
                  "type": "stones:set_block",
                  "block": "minecraft:air",
                  "pos": "$current"
                }
              ]
            }
          ],
          "render_mode": "BILLBOARD",
          "texture": "minecraft:textures/particle/glint.png"
        }
      ]
    }
  ],
  "_template_hash": "2297670a6a07bd0fc4572c14401da41f9bf392fa70fccbfd19fd536b92cc92c9"
}